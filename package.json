{
  "name": "dungeon-pact",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "simulate": "tsx scripts/simulate.ts",
    "test:network": "tsx scripts/network-smoke.ts",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json vite.config.ts wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.33.1",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
